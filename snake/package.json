{
  "name": "snake-game",
  "version": "1.0.0",
  "description": "A simple Snake game",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.snake.game",
    "productName": "Snake Game",
    "files": [
      "electron.js",
      "index.html",
      "style.css",
      "main.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
